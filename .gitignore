# OS junk
.DS_Store
Thumbs.db
desktop.ini
DocToClaude.md

# Generated at deploy time from the THE_ACCESS_CODE GitHub Actions secret
# (see .github/workflows/deploy.yml) — never commit the real password hash.
# A local dev-only copy is fine to keep here uncommitted for local testing.
js/auth-config.js

# Editor/IDE
.vscode/
.idea/
*.swp

# Logs
*.log
npm-debug.log*

# In case a build tool or local tooling gets added later
node_modules/
dist/
.env
.env.local

# Python (running refsol.py locally, ad-hoc scripts, etc.)
__pycache__/
*.pyc

# OS-level temp files
*.tmp
*~
